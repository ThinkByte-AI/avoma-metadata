# --- Avoma ---
AVOMA_API_KEY=your_avoma_api_key_here
# AVOMA_BASE_URL=https://api.avoma.com/v1   # override only if Avoma tells you to
# AVOMA_RPM=55                              # stay under the 60 req/min limit

# --- S3 / AWS ---
S3_BUCKET=my-avoma-archive
S3_PREFIX=avoma
AWS_REGION=us-east-1
# Storage classes (defaults match your "occasional access" choice):
VIDEO_STORAGE_CLASS=GLACIER_IR      # Glacier Instant Retrieval: ~$4/TB/mo, ms reads
TRANSCRIPT_STORAGE_CLASS=STANDARD   # tiny files, keep hot for querying

# AWS credentials: boto3 reads these automatically. Either set them here...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# ...or use `aws configure` / an IAM role instead.
