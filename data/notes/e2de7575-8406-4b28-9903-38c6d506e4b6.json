              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Participants highlighted challenges in obtaining reliable revenue and employee numbers, often using LinkedIn and government reports for approximations.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "54c22177-a081-45a2-b80d-09e1118ceea7",
