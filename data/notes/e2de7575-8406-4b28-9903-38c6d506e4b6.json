            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The meeting focused on refining the scoring formula for evaluating diagnostic centers, particularly addressing revenue data and proposing a minimum value to prevent skewed scores.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "8c2b0833-dec6-44fe-aaf2-1e9bfd0b5262",
