{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListArchiveBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_S3_BUCKET"
    },
    {
      "Sid": "ReadArchiveObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_S3_BUCKET/*"
    },
    {
      "Sid": "InvokeEmbeddingAndChatModels",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": [
        "arn:aws:bedrock:ap-south-1::foundation-model/amazon.titan-embed-text-v2:0",
        "arn:aws:bedrock:ap-south-1::foundation-model/zai.glm-5"
      ]
    }
  ]
}
