# Copy to .env and fill in. Never commit .env.

# --- App ---------------------------------------------------------------
# production | dev-mock  (dev-mock seeds clearly labelled [SAMPLE] data; never use with real users)
APP_MODE=production
LOG_LEVEL=INFO

# --- Database (docker compose builds DATABASE_URL from this password) ---
POSTGRES_PASSWORD=mi
# Used by tests run from the host:
DATABASE_URL_TEST=postgresql+psycopg://mi:mi@localhost:5433/meeting_intel_test

# --- AWS -----------------------------------------------------------------
# Credentials come from the standard AWS chain: env vars, ~/.aws profile, or an IAM role.
# For local dev, docker compose also reads ../.env (the archive repo's key file) if present.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Required: the bucket that holds the meeting archive.
S3_BUCKET=
# Comma-separated prefixes to scan.
S3_PREFIXES=avoma/
# Folder (inside the container) with the meeting metadata CSVs; compose mounts ../data/metadata here.
METADATA_DIR=/data/metadata

# --- Bedrock -----------------------------------------------------------------
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=512
EMBED_CONCURRENCY=32
BEDROCK_CHAT_MODEL=zai.glm-5
# Max cosine distance for a semantic match (lower = stricter).
SEMANTIC_MAX_DISTANCE=0.72

# --- Auth -------------------------------------------------------------------
# Required: long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_TTL_MIN=720
# Set true when served over HTTPS.
COOKIE_SECURE=false
# First admin, created on startup only if there are no users yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Playback ------------------------------------------------------------
PRESIGN_TTL_SEC=900
