              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Vinay Kovvuri explained the approach of their SEO product, which involves understanding a company's topical knowledge base, generating a content plan, and monitoring analytics to achieve traffic goals.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "2720753e-ee34-4439-b529-e4b6fc6e651d",
                    "time": 803.02496,
                    "highlight_note_list_item": true,
