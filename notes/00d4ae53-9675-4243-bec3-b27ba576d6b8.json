              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The product aims to provide suggestions for content creation by clustering keywords based on intent and relevance, and it includes a content editor for optimizing content.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "e5810aa8-a17c-4966-9bbe-20d2e8244103",
