            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The team is working on an SEO product as part of a larger digital marketing strategy and seeks input to ensure alignment with current organizational workflows and goals.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
