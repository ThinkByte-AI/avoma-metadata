              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Goutham Kumar mentioned that Medibody is focusing on creating pages independently using a framework tool to have more control over design and changes, particularly for surgeries and labs.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
