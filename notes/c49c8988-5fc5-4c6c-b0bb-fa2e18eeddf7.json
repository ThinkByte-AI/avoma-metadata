        {
          "children": [
            {
              "text": "Metadata Efficiency and Targeted Lead Generation",
              "object": "text"
            }
          ],
          "object": "block",
          "type": "header-2",
          "data": {
            "block_key": "metadata_efficiency_and_targeted_lead_generation",
            "highlight_notes_title": true,
            "machine_title": true
          }
        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Inefficient lead generation from non-targeted or saturated locations, leading to wasted efforts in areas like Raichoti, which are already saturated with stores.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "34986971-43e6-4754-8cc1-0715551aa53f",
                    "time": 251.055,
                    "highlight_note_list_item": true,
                    "turing_note": true,
                    "model": "v11"
                  }
