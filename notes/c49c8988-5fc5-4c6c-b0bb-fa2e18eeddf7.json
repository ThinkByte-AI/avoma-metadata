              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Increase focus on towns with high lead potential and prioritize high-quality leads from areas with better opportunities. Experiment with convincing potential leads to consider locations with higher demand.",
                      "object": "text",
                      "marks": []
                    }
