              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Focus on improving metadata efficiency by targeting specific areas for lead generation, like Kadapa, Anantapur, Nellore, and Raichoti. This involves prioritizing high-quality leads from areas with greater potential and avoiding saturated locations.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "fe1816d7-fd26-4643-b9e2-965f5b8a4248",
                    "time": 373.66,
                    "highlight_note_list_item": true,
                    "turing_note": true,
                    "model": "v11"
