            "block_key": "content_development",
            "highlight_notes_title": true,
            "machine_title": true
          }
        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Develop thought leadership content, including webinars, to emphasize product differentiation and USP. Focus on creating 75 growth-focused blogs, 25 embedded blogs, and a strategic backlink plan to enhance SEO.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "e55ecbe8-1b91-40a3-bfbb-5372cf84f6b0",
