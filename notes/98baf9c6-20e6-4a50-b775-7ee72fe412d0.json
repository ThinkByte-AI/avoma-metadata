              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Emphasis on creating content such as case studies, testimonials, user stories, and thought leadership materials to enhance product value, distinguishing through unique selling propositions (USPs) and differentiation in the market. Content includes landing pages, off-page SEO with backlinks, and thought leadership like webinars.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "057b7e54-ae31-4ff6-9c76-b632b0b90b52",
