          "data": {
            "block_key": "integration_of_google_ads_with_superphone_via_pabbly",
            "highlight_notes_title": true,
            "machine_title": true
          }
        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Pabbly will be used to automate data processes and integrate Google Forms with Superphone. This allows lead data to be automatically pushed to Superphone for further processing.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "05e39a0c-d22e-4e35-ab8a-051cb0dcfedd",
                    "time": 123.759995,
                    "highlight_note_list_item": true,
