        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The meeting was about website development for showcasing the company's unique offerings, with specific focus on the homepage design, content clarity, and aligning the website imagery with the company's value proposition",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
