                    "model": "v8"
                  }
                }
              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The team discussed how to effectively represent the company's highquality water purifiers and technologyfirst approach, addressing Patnaik's feedback on not prompting for mobile app downloads until after a purchase is made",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
