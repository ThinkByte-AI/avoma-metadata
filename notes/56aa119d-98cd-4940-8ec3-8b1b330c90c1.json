              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Patnaik, the prospect, was satisfied with the brand positioning efforts and emphasized the importance of using simple language and strategically placing images and patents to convey the right message without making them downloadable",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "6c39acb8-c474-422f-9dd6-296e80d7ff09",
                    "time": 0,
                    "highlight_note_list_item": true,
