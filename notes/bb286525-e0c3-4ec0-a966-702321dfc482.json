            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Acharya",
                      "object": "text"
                    }
                  ],
                  "object": "block",
                  "type": "paragraph"
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "text": "Follow up with the 600 people who do not have layers integrated and inform them that their list is not supported, promising to notify them once it is supported.",
                              "object": "text",
                              "marks": []
                            }
                          ],
                          "object": "block",
                          "type": "transcript",
                          "data": {
                            "uuid": "564540c9-9a0c-4cec-996b-f0a33c8e4b74",
                            "time": 601.98,
                            "highlight_note_list_item": true,
                            "machine_note": true,
                            "model": "machine_note_cleaned"
                          }
                        }
                      ],
                      "object": "block",
                      "type": "list-item",
                      "data": {}
                    }
                  ],
                  "object": "block",
                  "type": "unordered-list",
                  "data": {
                    "block_key": null,
                    "highlight_notes_list": true,
                    "machine_speaker_list": true
                  }
                }
              ],
              "object": "block",
              "type": "list-item",
