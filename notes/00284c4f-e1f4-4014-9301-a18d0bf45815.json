              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Provide strategic consulting for aligning AI solutions with client needs, focusing on reducing costs and improving lead accuracy. Extract relevant leads using AI-driven data analysis and enrichment techniques tailored to specific business contexts.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
