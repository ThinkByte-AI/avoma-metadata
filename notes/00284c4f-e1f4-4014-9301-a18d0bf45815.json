              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Thinkbyte focuses on cost-effective lead generation and marketing solutions, automating marketing processes to improve efficiency. They aim to provide more precise targeting and lead qualification to enhance conversion rates and reduce marketing costs.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
