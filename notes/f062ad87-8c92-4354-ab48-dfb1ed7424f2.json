        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Hardik discussed the need for building online presence for small businesses in the home improvement sector, focusing on pre-paint and post-paint categories.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "e9637008-6a02-4c24-beb9-530de5fe70e8",
