                  }
                }
              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Harsha and his team have experience in setting up and redesigning websites using platforms like Shopify, Wix, and WooCommerce, though not specifically in home decor.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "999e09e4-5ee6-4da3-a7ea-3d0e9b733fa6",
                    "time": 772.625,
