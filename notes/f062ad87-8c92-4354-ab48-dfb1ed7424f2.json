                    "highlight_note_list_item": true,
                    "turing_note": true,
                    "model": "v11"
                  }
                }
              ],
              "object": "block",
              "type": "list-item",
              "data": {}
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "The primary goal is to enhance brand visibility and trust online, rather than focusing on direct e-commerce sales.",
                      "object": "text",
                      "marks": []
                    }
                  ],
                  "object": "block",
                  "type": "transcript",
                  "data": {
                    "uuid": "5195c457-7ec2-47c1-b814-08de586d91a1",
